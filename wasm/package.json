{
  "name": "@stll/regex-set-wasm",
  "version": "1.0.9",
  "description": "Multi-pattern regex for browsers via WebAssembly. Same API as @stll/regex-set.",
  "keywords": [
    "multi-pattern",
    "napi-rs",
    "regex",
    "regex-set",
    "rust",
    "wasm"
  ],
  "homepage": "https://github.com/stella/regex-set#readme",
  "bugs": {
    "url": "https://github.com/stella/regex-set/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/regex-set.git"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "module": "dist/wasm.mjs",
  "types": "dist/wasm.d.mts",
  "exports": {
    ".": {
      "types": "./dist/wasm.d.mts",
      "import": "./dist/wasm.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./single-thread": {
      "types": "./dist/single-thread.d.mts",
      "import": "./dist/single-thread.mjs"
    },
    "./single-thread/inline": {
      "types": "./dist/single-thread-inline.d.mts",
      "import": "./dist/single-thread-inline.mjs"
    },
    "./single-thread/wasm": {
      "default": "./dist/regex-set.single-thread.wasm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.1",
    "@napi-rs/wasm-runtime": "1.2.5"
  },
  "peerDependencies": {
    "vite": ">=5 <10"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
