{
  "name": "@stll/regex-set",
  "version": "1.0.6",
  "description": "Single-pass multi-pattern regex for Node.js/Bun. Backtracking-immune, Unicode-aware Rust engine via NAPI-RS.",
  "keywords": [
    "multi-pattern",
    "napi-rs",
    "native",
    "regex",
    "regex-set",
    "rust"
  ],
  "homepage": "https://github.com/stella/regex-set#readme",
  "bugs": {
    "url": "https://github.com/stella/regex-set/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/regex-set.git"
  },
  "files": [
    "dist",
    "index.cjs"
  ],
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fix:loader": "node scripts/fix-napi-loader.mjs",
    "build": "node scripts/build-native.mjs --platform --dts index.d.cts --release",
    "build:debug": "node scripts/build-native.mjs --platform --dts index.d.cts",
    "build:wasm": "node scripts/build-native.mjs --platform --target wasm32-wasip1-threads --dts index.d.cts --release",
    "build:js": "node scripts/ensure-wasm-artifact.mjs && tsdown && node scripts/fix-napi-loader.mjs && node scripts/check-wasm-compat.mjs",
    "artifacts": "napi artifacts",
    "universal": "napi universal",
    "prepublishOnly": "napi prepublish -t npm && tsdown && node scripts/fix-napi-loader.mjs",
    "test": "bun run check:release-artifacts && bun test __test__/index.spec.ts",
    "test:props": "bun test __test__/properties.spec.ts",
    "perf:contracts": "bun scripts/contract-fixture-perf.mjs",
    "test:runtime:bun": "bun scripts/runtime-smoke.mjs",
    "test:runtime:node": "node scripts/runtime-smoke.mjs",
    "version:sync": "node scripts/version-sync.mjs sync",
    "version:check": "node scripts/version-sync.mjs check",
    "rust:hawk": "cargo +1.97.1 hawk check --target-dir target/hawk -D warnings -A hawk::dead_public -A hawk::unnecessary_public",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/version-sync.mjs sync",
    "release:prepare": "node scripts/prepare-release-package.mjs",
    "release:check": "node scripts/check-release-tarballs.mjs",
    "format": "oxfmt . \"!provenance/**\" \"!.ai/**\" \"!.agents/**\" \"!.claude/**\" \"!AGENTS.md\" \"!CLAUDE.md\" \"!GEMINI.md\" && cargo fmt --all",
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --type-aware --fix .",
    "check:wasm-compat": "node scripts/check-wasm-compat.mjs",
    "check:release-artifacts": "bun scripts/wasi-artifact-contract.mjs",
    "check:workflow-package-manager": "node scripts/check-workflow-package-manager.mjs",
    "bench": "bun __bench__/speed.ts",
    "bench:all": "bun run bench && bun run bench:fallback",
    "bench:fallback": "bun __bench__/fancy-fallback.ts",
    "bench:install": "cd __bench__ && bun install",
    "bench:download": "bash __bench__/download-corpus.sh",
    "sync-ai": "bash scripts/sync-ai-skills.sh",
    "sync-ai:check": "bash scripts/sync-ai-skills.sh --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@napi-rs/cli": "3.8.6",
    "@napi-rs/wasm-runtime": "1.2.2",
    "@stll/oxlint-config": "0.6.0",
    "@stll/typescript-config": "0.6.0",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^26.2.0",
    "bun-types": "1.4.1",
    "emnapi": "2.0.0-alpha.3",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "napi": {
    "binaryName": "regex-set",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "bun": ">=1.4.1",
    "node": ">= 18"
  },
  "packageManager": "bun@1.4.1"
}
